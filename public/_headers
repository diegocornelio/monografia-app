# Cabecalhos aplicados pelo Cloudflare Pages.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com; connect-src 'self' https://www.googleapis.com https://oauth2.googleapis.com https://api.crossref.org https://api.openalex.org; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://accounts.google.com https://drive.google.com; base-uri 'self'; form-action 'self'

# O HTML nunca fica em cache: e ele que aponta para os ativos com hash.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Ativos com hash no nome podem ser cacheados por um ano.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
